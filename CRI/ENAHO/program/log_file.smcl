{com}. 
. * Beneficiarios PTMC
. gen percibe_ptmc=(a9a==1 | a9a==5)
{txt}
{com}. bys idh_ch: egen ptmc_ch=max(percibe_ptmc)
{txt}
{com}. 
. replace ing_ptmc=. if yhog==.
{txt}(0 real changes made)

{com}. replace ptmc_ch  = 1 if (ing_ptmc>0 & ing_ptmc!=.)
{txt}(0 real changes made)

{com}. 
. * Beneficiarios PNC
. gen pnc_ci=(a11==6)
{txt}
{com}. gen ing_pnc = 0
{txt}
{com}. replace ing_pnc=. if yhog==.
{txt}(0 real changes made)

{com}. 
. * Adultos mayores
. gen mayor64_ci=(edad_ci>64 & edad_ci!=.)
{txt}
{com}. 
. * Ingreso neto del hogar
. gen y_pc_net = (yhog - ing_ptmc -ing_pnc) / nmiembros_ch
{txt}
{com}. 
. * Etiquetas
. lab def ptmc_ch 1 "Beneficiario PTMC" 0 "No beneficiario PTMC"
{txt}
{com}. lab val ptmc_ch ptmc_ch
{txt}
{com}. 
. lab def pnc_ci 1 "Beneficiario PNC" 0 "No beneficiario PNC"
{txt}
{com}. lab val pnc_ci pnc_ci
{txt}
{com}. 
{txt}end of do-file

{com}. 