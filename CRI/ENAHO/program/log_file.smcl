. ***************
. * condocup_ci *
. ***************
. gen condocup_ci=.
{txt}(30,846 missing values generated)

{com}. replace condocup_ci=1 if b1==1 | (b2 >= 1 & b2 <= 8) | b3==1 | (b5 >= 1 & b5 <= 5) & estabili != 30 /*ocupado frecuente*/
{txt}(12,784 real changes made)

{com}. replace condocup_ci=1 if b1==1 | (b2 >= 1 & b2 <= 8) | b3==1 | (b5 >= 1 & b5 <= 5) & estabili == 30 /*ocupado estacional*/
{txt}(0 real changes made)

{com}. replace condocup_ci=2 if (b6== 8 | b6== 9) & ((b7a== 1 | b7b== 2 | b7c== 3 | b7d== 4 | b7e== 5 | b7f==6 | b7g == 7 | b7h ==8 | b7i ==9 | b7j == 10 | b7k== 11) | (b8==1 | b8==2 | b8==3)) & g6==1 /*desempleado cesante*/
{txt}(677 real changes made)

{com}. replace condocup_ci=2 if (b6== 8 | b6==9 ) & ((b7a== 1 | b7b== 2 | b7c== 3 | b7d== 4 | b7e== 5 | b7f== 6 | b7g== 7 | b7h ==8 | b7i ==9 | b7j== 10 | b7k== 11) | (b8==1 | b8==2 | b8==3)) & g6==2 /*desempleado primera vez*/
{txt}(319 real changes made)

{com}. recode condocup_ci .=3 if  edad_ci>=12 /*Modificado de 10 a 12 aÃ±os SGR 05/2017*/
{txt}(12,985 changes made to {bf:condocup_ci})

{com}. replace condocup_ci=4 if  edad_ci<12
{txt}(4,081 real changes made)

{com}. label var condocup_ci "Condicion de ocupación de acuerdo a def de cada pais"
{txt}
{com}. label define condocup_ci 1 "Ocupado" 2 "Desocupado" 3 "Inactivo" 4 "Menor que 12" 
{txt}
{com}. label value condocup_ci condocup_ci
{txt}
{com}. 
. *******************
. ***categoinac_ci***
. *******************
. /*
> raznoacteco:
>            1 pensionado o jubilado
>            2 rentista
>            3 asistencia a centro de estudios
>            4 obligaciones del propio hogar
>            5 con discapacidad o enfermedad
>            6 otro motivo
> */
. gen categoinac_ci = 1 if (raznoacteco == 1 & condocup_ci==3)
{txt}(26,906 missing values generated)

{com}. replace categoinac_ci = 2 if (raznoacteco == 3 & condocup_ci==3)
{txt}(2,626 real changes made)

{com}. replace categoinac_ci = 3 if (raznoacteco == 4 & condocup_ci==3)
{txt}(4,456 real changes made)

{com}. replace categoinac_ci = 4 if  ((categoinac_ci ~=1 & categoinac_ci ~=2 & categoinac_ci ~=3) & condocup_ci==3)
{txt}(1,963 real changes made)

{com}. label var categoinac_ci "Categoría de inactividad"
{txt}
{com}. label define categoinac_ci 1 "jubilados o pensionados" 2 "Estudiantes" 3 "Quehaceres domésticos" 4 "Otros"
{txt}
{com}. 
