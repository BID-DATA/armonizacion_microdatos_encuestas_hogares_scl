. ***************
. * spublico_ci *
. ***************
. *Personas que trabajan en el sector publico.
. * Esta varible no existía en el código de las armonizaciones anteriores. Se crea  a partir de claspubprivpri (clasificación público-privado del empleo principal) en 2023
. gen spublico_ci=.
{txt}(30,846 missing values generated)

{com}. replace spublico_ci =1 if  claspubprivpri==1 &  emp_ci==1
{txt}(1,781 real changes made)

{com}. label var spublico_ci "Personas que trabajan en el sector público"
{txt}
{com}. 
. *************
. * tamemp_ci *
. *************
. *Costa Rica Pequeña 1 a 5, Mediana 6 a 19, Grande Más de 19
. /*
> gen tamemp_ci = 1 if (c10>=1 & c10<=5)
> replace tamemp_ci = 2 if (c10>=6 & c10<=19)
> replace tamemp_ci = 3 if (c10>19)
> */
. * MLO, según los codigos del formulario
. gen tamemp_ci = 1 if (c10>=1 & c10<=5)
{txt}(25,381 missing values generated)

{com}. replace tamemp_ci = 2 if (c10>=6 & c10<=10)
{txt}(1,989 real changes made)

{com}. replace tamemp_ci = 3 if (c10>10 & c10!=.)
{txt}(5,330 real changes made)

{com}. replace tamemp_ci = . if c10==99 /*missing*/
{txt}(65 real changes made, 65 to missing)

{com}. 
. label define tamemp_ci 1 "Pequeña" 2 "Mediana" 3 "Grande"
{txt}
{com}. label value tamemp_ci tamemp_ci
{txt}
{com}. label var tamemp_ci "Tamaño de empresa"
{txt}
{com}. 
