. ***************
. * clasehog_ch *
. ***************
. gen byte clasehog_ch=0
{txt}
{com}. **** unipersonal
. replace clasehog_ch=1 if nhijos_ch==0 & nconyuges_ch==0 & notropari_ch==0 & notronopari_ch==0
{txt}(1,730 real changes made)

{com}. **** nuclear   (child with or without spouse but without other relatives)
. replace clasehog_ch=2 if (nhijos_ch>0| nconyuges_ch>0) & (notropari_ch==0 & notronopari_ch==0)
{txt}(19,940 real changes made)

{com}. **** ampliado
. replace clasehog_ch=3 if ((clasehog_ch ==2 & notropari_ch>0) & notronopari_ch==0) |(notropari_ch>0 & notronopari_ch==0) 
{txt}(8,417 real changes made)

{com}. **** compuesto  (some relatives plus non relative)
. replace clasehog_ch=4 if ((nconyuges_ch>0 | nhijos_ch>0 | notropari_ch>0) & (notronopari_ch>0))
{txt}(626 real changes made)

{com}. **** corresidente
. replace clasehog_ch=5 if nhijos_ch==0 & nconyuges_ch==0 & notropari_ch==0 & notronopari_ch>0
{txt}(133 real changes made)

{com}. label variable clasehog_ch "Tipo de hogar"
{txt}
{com}. label define clasehog_ch 1 " Unipersonal" 2 "Nuclear" 3 "Ampliado" 
{txt}
{com}. label define clasehog_ch 4 "Compuesto" 5 " Corresidente", add
{txt}
{com}. label value clasehog_ch clasehog_ch
{txt}
{com}. 
