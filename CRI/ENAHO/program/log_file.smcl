. ***desemp_ci***
. ****************
. gen desemp_ci=(condocup_ci==2)
{txt}
{com}. label var desemp_ci "Desempleado que buscó empleo en el periodo de referencia"
{txt}
{com}.   
. *************
. *cesante_ci* 
. *************
. * MGD 12/4/2015: condicionado a que este desocupado
. gen cesante_ci=1 if g6==1 & condocup_ci==2
{txt}(30,169 missing values generated)

{com}. recode cesante_ci .=0 if condocup_ci==2
{txt}(319 changes made to {bf:cesante_ci})

{com}. * No todos los desempleados respondieron si han trabajado antes
. label var cesante_ci "Desocupado - definicion oficial del pais"
{txt}
{com}. 
. ************
. *durades_ci* 
. ************
. /*
>            1 un mes o menos
>            2 más de un mes a tres meses
>            3 más de tres meses a seis meses
>            4 más de seis meses a un año
>            5 más de un año a tres años
>            6 más de tres años
>            9 ignorado
> Obs. Unidad de medida: promedio de meses (por eso se divide entre 2)
> */
. gen durades_ci=.
{txt}(30,846 missing values generated)

{com}. *un mes o menos
. replace durades_ci=(1+4.3)/2/4.3 if g2==1
{txt}(403 real changes made)

{com}. *MÁS de 1 a 3 meses
. replace durades_ci=(1+3)/2 if g2==2
{txt}(296 real changes made)

{com}. *MÁS de 3 a 6 meses
. replace durades_ci=(3+6)/2 if g2==3
{txt}(147 real changes made)

{com}. *MÁS de 6 a 12 meses
. replace durades_ci=(6+12)/2 if g2==4
{txt}(167 real changes made)

{com}. *MÁS de 1 año a 3 años
. replace durades_ci=(12+36)/2 if g2==5
{txt}(110 real changes made)

{com}. *MÁS de 3 años
. replace durades_ci=(36+48)/2 if g2==6
{txt}(43 real changes made)

{com}. label variable durades_ci "Duracion del desempleo en meses"
{txt}
{com}.  
. **********
. * pea_ci *
. **********
. gen pea_ci=0
{txt}
{com}. replace pea_ci=1 if emp_ci==1 |desemp_ci==1
{txt}(13,780 real changes made)

{com}. label var pea_ci "Población Económicamente Activa"
{txt}
{com}. 
. ***************
. * desalent_ci *
. ***************
. *personas que creen que por alguna razon no conseguiran trabajo
. gen desalent_ci=(emp_ci==0 & (b8==5 | b8==6 |b8==7 |b8==8))
{txt}
{com}. replace desalent_ci=. if condact==.
{txt}(5,400 real changes made, 5,400 to missing)

{com}. label var desalent_ci "Trabajadores desalentados"
{txt}
{com}. 
. ***************
. * horaspri_ci *
. ***************
. *Horas totales trabajadas en la actividad principal
. *c2a1=horas normales empleo principal por semana
. gen horaspri_ci=c2a1 
{txt}(18,062 missing values generated)

{com}. replace horaspri_ci=. if c2a1==999
{txt}(8 real changes made, 8 to missing)

{com}. replace horaspri_ci=. if emp_ci==0
{txt}(0 real changes made)

{com}. label var horaspri_ci "Horas trabajadas semanalmente en el trabajo principal"
{txt}
{com}. 
. ***************
. * horastot_ci *
. ***************
. * Horas totales trabajadas en la actividad secundaria
. * c2b1 = horas normales empleo secundario por semana
. gen horassec_ci=c2b1 
{txt}(30,505 missing values generated)

{com}. replace horassec_ci=. if c2b1==999
{txt}(0 real changes made)

{com}. replace horassec_ci=. if emp_ci==0
{txt}(0 real changes made)

{com}. label var horassec_ci "Horas trabajadas semanalmente en el trabajo secundario"
{txt}
{com}. * Horas totales trabajadas en todas las actividades
. egen horastot_ci=rsum(horaspri_ci horassec_ci), missing 
{txt}(18,070 missing values generated)

{com}. replace horastot_ci=. if horaspri_ci==. & horassec_ci==.
{txt}(0 real changes made)

{com}. replace horastot_ci=. if emp_ci==0
{txt}(0 real changes made)

{com}. label var horastot_ci "Horas trabajadas semanalmente en todos los empleos"
{txt}
{com}. 
. *************
. * subemp_ci *
. *************
. * Modificacion MLO 12/18/2015: mal generada la variable, se corrije con las variables desea trabajar mas horas y disponibilidad.
. *c3 = hubiera querido trabajar más horas
. gen subemp_ci=0
{txt}
{com}. replace subemp_ci=1 if (horaspri_ci<=30 & c3==1 & (c4a==1 | c4a==2)) & emp_ci==1
{txt}(1,088 real changes made)

{com}. replace subemp_ci=. if emp_ci==0
{txt}(18,062 real changes made, 18,062 to missing)

{com}. label var subemp_ci "Personas en subempleo por horas"
{txt}
{com}. 
. *****************
. * tiempoparc_ci *
. *****************
. *Trabajadores a medio tiempo: personas que trabajan menos de 30 horas a la semana y no quieren trabajar mas.
. gen tiempoparc_ci=(horastot_ci<=30 & c3==2)
{txt}
{com}. replace tiempoparc_ci=. if emp_ci==0
{txt}(18,062 real changes made, 18,062 to missing)

{com}. label var tiempoparc_c "Personas que trabajan medio tiempo" 
{txt}
{com}. 
