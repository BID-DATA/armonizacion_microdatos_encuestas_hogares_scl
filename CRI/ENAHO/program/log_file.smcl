. **********
. * dis_ci *
. **********
. /* ¿(Nombre) presenta alguna limitación que le dificulte o impida permanentemente...
> a8a     
>            0 No tiene ninguna
>            1 Ver aún con los anteojos o lentes puestos
>            2 Oír
>            3 Hablar
>            4 Caminar o subir gradas
>            5 Utilizar brazos y manos
>            6 De tipo intelectual (Síndrome de Down, otros)
>            7 De tipo mental (bipolar, esquizofrenia, otros)
>            9 Ignorado
> a8b
>            0 No tiene segunda discapacidad
>            1 Ver aún con los anteojos o lentes puestos
>            2 Oír
>            3 Hablar
>            4 Caminar o subir gradas
>            5 Utilizar brazos y manos
>            6 De tipo intelectual (Síndrome de Down, otros)
>            7 De tipo mental (bipolar, esquizofrenia, otros)
>            9 Ignorado
> 
> */         
.         * No considerar respuestas 6 y 7
. gen dis_ci =.
{txt}(30,846 missing values generated)

{com}. replace dis_ci = 1 if (a8a >= 1 & a8a <= 5) | (a8b >= 1 & a8b <= 5)
{txt}(2,368 real changes made)

{com}. replace dis_ci = 0 if (a8a == 0 | a8a == 6 | a8a == 7)
{txt}(28,478 real changes made)

{com}. 
. ************
. * disWG_ci *
. ************
. gen disWG_ci =.
{txt}(30,846 missing values generated)

{com}. 
. ************
. * CRI_dis_ci *
. ************
. gen CRI_dis_ci =dis_ci
{txt}
{com}. 
. **********
. * dis_ch *
. **********              
. egen dis_ch  = sum(dis_ci), by(idh_ch) 
{txt}
{com}. replace dis_ch=1 if dis_ch>=1 & dis_ch!=. 
{txt}(1,138 real changes made)

{com}. 
