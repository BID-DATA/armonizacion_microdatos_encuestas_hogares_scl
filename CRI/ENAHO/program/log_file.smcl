. global ruta = "${c -(}surveysFolder{c )-}"
{txt}
{com}. capture drop _merge
{txt}
{com}. merge m:1 pais_c anio_c using "$ruta\general_documentation\data_externa\poverty\International_Poverty_Lines\5_International_Poverty_Lines_LAC_long_PPP17", keepusing (lp19_2011 lp31_2011 lp5_2011 lp365_2017 lp685_2017 lp14_2017 lp81_2017 ppp_2011 ppp_2017 cpi cpi2011 cpi2017 cpi_2011 cpi_2017 tc_wdi ppp_wdi)
{res}{txt}{p 0 7 2}
(variable
{bf:pais_c} was {bf:str3}, now {bf:str74} to accommodate using data's values)
{p_end}

{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}             935
{txt}{col 9}from master{col 30}{res}               0{txt}  (_merge==1)
{col 9}from using{col 30}{res}             935{txt}  (_merge==2)

{col 5}Matched{col 30}{res}          30,846{txt}  (_merge==3)
{col 5}{hline 41}

{com}. 
. drop if _merge ==2
{txt}(935 observations deleted)

{com}. 
. g tc_c     = tc_wdi
{txt}(30,846 missing values generated)

{com}. g ppp_c    = ppp_wdi
{txt}(30,846 missing values generated)

{com}. 
. g cpi_c    = cpi
{txt}
{com}. g ratio_cpi2011 = cpi_2011
{txt}
{com}. g ratio_cpi2017 = cpi_2017
{txt}
{com}. 
. drop tc_wdi ppp_wdi cpi_2011 cpi_2017 _merge
{txt}
{com}. 
. *====================================================================================================================================*
. *                                                         VARIABLES DE LÍNEAS DE POBREZA                                              *
. *====================================================================================================================================*
. label var tc_c     "Tipo de cambio oficial (año de la encuesta)"
{txt}
{com}. label var ppp_c    "Poder de paridad adquisitivo (año de la encuesta)"
{txt}
{com}. label var ppp_2011 "Poder de paridad adquisitivo (PPP) 2011"
{txt}
{com}. label var ppp_2017 "Poder de paridad adquisitivo (PPP) 2017"
{txt}
{com}. 
. label var cpi_c   "Índice de precios al consumidor (año de la encuesta)"
{txt}
{com}. label var cpi2011 "Índice de precios al consumidor (2011)"
{txt}
{com}. label var cpi2017 "Índice de precios al consumidor (2017)"
{txt}
{com}. 
. label var ratio_cpi2011 "Tasa de índice de precios al consumidor (CPI_actual/CPI_2011)"
{txt}
{com}. label var ratio_cpi2017 "Tasa de índice de precios al consumidor (CPI_actual/CPI_2017)"
{txt}
{com}. 
. label var lp19_2011 "Línea de pobreza extrema (WB) USD 1.9 per capita, PPP 2011"
{txt}
{com}. label var lp31_2011 "Línea de pobreza extrema USD 3.1 per capita, PPP 2011"
{txt}
{com}. label var lp5_2011  "Línea de pobreza moderada USD 5 per capita, PPP 2011"
{txt}
{com}. 
. label var lp365_2017 "Línea de pobreza extrema USD 3.1 per capita, moneda local PPP 2017"
{txt}
{com}. label var lp685_2017 "Línea de pobreza moderada USD 6.85 per capita, moneda local PPP 2017"
{txt}
{com}. label var lp14_2017  "Línea de vulnerabilidad USD 14.15 per capita, moneda local PPP 2017"
{txt}
