. ************
. * civil_ci *
. ************
. /*
> a6:
>            0 menor de 10 años
>            1 en unión libre o juntado(a)
>            2 casado(a)
>            3 divorciado(a)
>            4 separado(a)
>            5 viudo(a)
>            6 soltero(a)
>            9 ignorado
> 
> */
. 
. gen civil_ci=.
{txt}(30,846 missing values generated)

{com}. replace civil_ci=1 if a6==6
{txt}(11,416 real changes made)

{com}. replace civil_ci=2 if a6==1 | a6==2
{txt}(11,996 real changes made)

{com}. replace civil_ci=3 if a6==3 | a6==4
{txt}(2,887 real changes made)

{com}. replace civil_ci=4 if a6==5
{txt}(1,284 real changes made)

{com}. label variable civil_ci "Estado civil"
{txt}
{com}. label define civil_ci 1 "Soltero" 2 "Union formal o informal"
{txt}
{com}. label define civil_ci 3 "Divorciado o separado" 4 "Viudo" , add
{txt}
{com}. label value civil_ci civil_ci
{txt}
{com}. 
