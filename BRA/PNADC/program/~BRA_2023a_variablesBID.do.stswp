****************
***aguared_ch***
****************
gen aguared_ch = .
label var aguared_ch "Fuente de agua por red"

*****************
*aguafconsumo_ch*
*****************
gen aguafconsumo_ch = 0
label var aguafconsumo_ch "Principal fuente de agua utilizada por el hogar para beber"

*****************
*aguafuente_ch*
*****************
